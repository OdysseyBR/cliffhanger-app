# Copie para `.env` e preencha com a web config pública do Firebase
# (mesmo projeto da Cliffhanger Store — conta única) e a URL da loja.
#
#   .env é ignorado pelo git; os valores são públicos por definição
#   (web config do Firebase), mas não vão para o repositório.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Base da API da loja (endpoints /api/products, /api/library…)
EXPO_PUBLIC_STORE_URL=https://www.cliffhangerstore.xyz

# Client ID OAuth do Google — tipo Android (Google Cloud → APIs e serviços →
# Credenciais), criado com nome do pacote + SHA-1 do keystore da EAS.
# Identificador público (entra no bundle); habilitar "Enable custom URI
# scheme" nas Advanced Settings do client para o login nativo funcionar.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# App ID do Facebook (Meta Developers) - Etapa E. Identificador publico
# (entra no bundle); o provider Facebook precisa estar habilitado no
# Firebase Console (Authentication > Sign-in method) com App ID + Secret.
EXPO_PUBLIC_FACEBOOK_APP_ID=
