# Copie para `.env` e preencha com a web config pública do Firebase
# (mesmo projeto da Cliffhanger Store — conta única) e a URL da loja.
#
#   .env é ignorado pelo git; os valores são públicos por definição
#   (web config do Firebase), mas não vão para o repositório.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Base da API da loja (endpoints /api/products, /api/library…)
EXPO_PUBLIC_STORE_URL=https://www.cliffhangerstore.xyz
